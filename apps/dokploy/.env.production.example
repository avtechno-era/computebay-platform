PORT=3000
NODE_ENV=production

# ComputeBay: default broker the appliance activates against. This is a
# build-time constant — Next.js inlines NEXT_PUBLIC_* into the client bundle at
# `next build`, so it must be present here when the image is built (it cannot be
# injected at install time). Managed appliances get this pre-filled on the setup
# screen; self-host owners override it under "Advanced".
NEXT_PUBLIC_COMPUTEBAY_BROKER_URL=https://computebay-fleet-service.avtechno.org/api